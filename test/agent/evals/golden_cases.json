{
  "about": "FiNN agent golden eval set over the demo data (today: Sat 10 Oct 2026). Run live with FINN_LIVE=1 (see docs/AGENT.md, Evals). kind: normal | edge | hinglish | adversarial. expect.ops = the exact multiset of saved actions (expect.opsAnyOf = a list of acceptable multisets) (fields must match; a list means any of; {\"re\": ...} is a regex). expect.question = the last turn asks and saves nothing. expect.reply = the reply is one of these fixed answers (greeting, thanks, advice, scope, unsupported, unclear, help:<topic>). expect.refuse = nothing saved and the reply is a fixed refusal. expect.answer = text the reply must contain. expect.navigate = the route the turn opens or offers. expect.mustNotContain = text that must never appear in the reply.",
  "thresholds": { "normal": 0.95, "edge": 0.85, "hinglish": 0.85, "adversarial": 1.0 },
  "cases": [
    { "id": "lunch_cash", "kind": "normal", "turns": ["spent 450 on lunch in cash"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "expense", "amount": 450, "categoryId": "cat_food", "date": "2026-10-10" } }] } },
    { "id": "groceries_upi", "kind": "normal", "turns": ["paid 1,200 for groceries from SBI via UPI"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "expense", "amount": 1200, "categoryId": "cat_groceries" } }] } },
