    { "id": "freelance_party", "kind": "normal", "turns": ["got a 15k freelance payment from Acme in Axis"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "income", "amount": 15000, "categoryId": "cat_freelance", "counterparty": { "re": "Acme" } } }] } },
    { "id": "interest", "kind": "normal", "turns": ["got 2,100 interest in Axis"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "income", "amount": 2100, "categoryId": "cat_interest" } }] } },
    { "id": "lakh_bonus", "kind": "normal", "turns": ["received a 1.5L bonus in Axis"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "income", "amount": 150000 } }] } },
    { "id": "shoes_card", "kind": "normal", "turns": ["bought shoes for 2,500 on my HDFC card"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "expense", "amount": 2500, "categoryId": "cat_shopping" } }] } },
    { "id": "lent_amit", "kind": "normal", "turns": ["gave 300 to Amit, he will return it"], "expect": { "ops": [{ "action": "pending.create", "fields": { "direction": "owedToMe", "amount": 300, "counterparty": "Amit" } }] } },
    { "id": "borrowed_sneha", "kind": "normal", "turns": ["borrowed 1000 from Sneha"], "expect": { "ops": [{ "action": "pending.create", "fields": { "direction": "iOwe", "amount": 1000, "counterparty": "Sneha" } }] } },
    { "id": "settle_neha", "kind": "normal", "turns": ["Neha paid me back the 850 for the office lunch in cash"], "expect": { "ops": [{ "action": "pending.settle", "fields": { "pendingId": "pend_seed_297", "amount": 850 } }] } },
    { "id": "settle_karan", "kind": "normal", "turns": ["Karan paid back the 1200 for the team dinner into Axis"], "expect": { "ops": [{ "action": "pending.settle", "fields": { "pendingId": "pend_seed_305", "amount": 1200 } }] } },
