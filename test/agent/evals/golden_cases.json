    { "id": "follow_up_edit", "kind": "normal", "turns": ["spent 450 on lunch in cash", "actually make that 400"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "amount": 450, "categoryId": "cat_food" } }, { "action": "transactions.update", "fields": { "amount": 400 } }] } },
