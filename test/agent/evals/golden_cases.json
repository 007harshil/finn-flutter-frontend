    { "id": "q_owed", "kind": "normal", "turns": ["how much do people owe me?"], "expect": { "answer": "₹" } },
    { "id": "q_balance", "local": true, "kind": "normal", "turns": ["what's my balance?"], "expect": { "answer": "available" } },
