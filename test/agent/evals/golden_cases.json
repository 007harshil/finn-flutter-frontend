    { "id": "three_ops", "kind": "normal", "turns": ["I received ₹5,000 as salary yesterday in Axis, gave ₹300 to Utsav which is still pending, and bought protein powder for ₹5,000 from SBI"], "expect": { "ops": [{ "action": "transactions.create", "fields": { "type": "income", "amount": 5000, "categoryId": "cat_salary", "date": "2026-10-09" } }, { "action": "pending.create", "fields": { "direction": "owedToMe", "amount": 300, "counterparty": "Utsav" } }, { "action": "transactions.create", "fields": { "type": "expense", "amount": 5000, "categoryId": ["cat_health", "cat_fitness", "cat_shopping"] } }] } },
